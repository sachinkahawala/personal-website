---
import { site } from '../lib/site';
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border px-4 py-12 text-sm text-muted">
  <div class="mx-auto grid max-w-page grid-cols-1 gap-8 min-[720px]:grid-cols-[1fr_1fr_2fr] min-[720px]:gap-12 min-[720px]:px-8">
    <div>
      <h4 class="mb-3 font-mono text-xs uppercase tracking-[0.06em] text-subtle">Find me</h4>
      <ul class="flex list-none flex-col gap-2 p-0">
        <li><a class="group inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href={site.socials.linkedin} target="_blank" rel="noopener"><Icon name="lucide:linkedin" class="size-3.5 text-muted transition-colors duration-150 ease-out group-hover:text-accent" /> LinkedIn</a></li>
        <li><a class="group inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href={site.socials.github} target="_blank" rel="noopener"><Icon name="lucide:github" class="size-3.5 text-muted transition-colors duration-150 ease-out group-hover:text-accent" /> GitHub</a></li>
        <li><a class="group inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href={site.socials.scholar} target="_blank" rel="noopener"><Icon name="lucide:graduation-cap" class="size-3.5 text-muted transition-colors duration-150 ease-out group-hover:text-accent" /> Scholar</a></li>
        <li><a class="group inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href={`mailto:${site.email}`}><Icon name="lucide:mail" class="size-3.5 text-muted transition-colors duration-150 ease-out group-hover:text-accent" /> Email</a></li>
      </ul>
    </div>
    <div>
      <h4 class="mb-3 font-mono text-xs uppercase tracking-[0.06em] text-subtle">Site</h4>
      <ul class="flex list-none flex-col gap-2 p-0">
        <li><a class="inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href="/about">About</a></li>
        <li><a class="inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href="/blog">Writing</a></li>
        <li><a class="inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href="/projects">Projects</a></li>
        <li><a class="inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href="/papers">Papers</a></li>
        <li><a class="group inline-flex items-center gap-2 text-fg transition-colors duration-150 ease-out hover:text-accent" href="/rss.xml"><Icon name="lucide:rss" class="size-3.5 text-muted transition-colors duration-150 ease-out group-hover:text-accent" /> RSS</a></li>
      </ul>
    </div>
    <div>
      <h4 class="mb-3 font-mono text-xs uppercase tracking-[0.06em] text-subtle">Colophon</h4>
      <p class="mb-2">
        Built with <a class="text-fg transition-colors duration-150 ease-out hover:text-accent" href="https://astro.build" target="_blank" rel="noopener">Astro</a>.
        Designed and written by {site.name}.
      </p>
      <p class="font-mono text-xs text-subtle">© {year} {site.name}. {site.location}.</p>
    </div>
  </div>
</footer>
