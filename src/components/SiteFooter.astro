---
import { site } from '../lib/site';
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="cols">
    <div class="col">
      <h4>Find me</h4>
      <ul>
        <li><a href={site.socials.linkedin} target="_blank" rel="noopener"><Icon name="lucide:linkedin" /> LinkedIn</a></li>
        <li><a href={site.socials.github} target="_blank" rel="noopener"><Icon name="lucide:github" /> GitHub</a></li>
        <li><a href={site.socials.scholar} target="_blank" rel="noopener"><Icon name="lucide:graduation-cap" /> Scholar</a></li>
        <li><a href={`mailto:${site.email}`}><Icon name="lucide:mail" /> Email</a></li>
      </ul>
    </div>
    <div class="col">
      <h4>Site</h4>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Writing</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/papers">Papers</a></li>
        <li><a href="/rss.xml"><Icon name="lucide:rss" /> RSS</a></li>
      </ul>
    </div>
    <div class="col colophon">
      <h4>Colophon</h4>
      <p>
        Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.
        Designed and written by {site.name}.
      </p>
      <p class="copy">© {year} {site.name}. {site.location}.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-24);
    padding: var(--space-12) var(--space-4);
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }

  .cols {
    max-width: var(--page-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  h4 {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
    margin: 0 0 var(--space-3);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg);
    border-bottom: none;
  }

  a :global(svg) {
    width: 14px;
    height: 14px;
    color: var(--fg-muted);
  }

  a:hover { color: var(--accent); }
  a:hover :global(svg) { color: var(--accent); }

  .colophon p { margin: 0 0 var(--space-2); }

  .copy { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--fg-subtle); }

  @media (min-width: 720px) {
    .cols { grid-template-columns: 1fr 1fr 2fr; gap: var(--space-12); padding: 0 var(--space-8); }
  }
</style>
