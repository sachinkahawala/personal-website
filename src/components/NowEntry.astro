---
interface Props {
  date: Date;
  title?: string;
}
const { date, title } = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
---

<article class="border-t border-border py-6 first:border-t-0 first:pt-0">
  <header class="mb-3 flex items-baseline gap-4">
    <time class="font-mono text-sm text-accent" datetime={dateStr}>{dateStr}</time>
    {title && <h3 class="text-lg font-semibold leading-tight text-fg">{title}</h3>}
  </header>
  <div class="[&_p]:my-2 [&_p]:leading-[1.6] [&_p]:text-fg [&_strong]:font-semibold [&_strong]:text-fg"><slot /></div>
</article>
