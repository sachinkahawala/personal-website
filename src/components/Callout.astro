---
import { Icon } from 'astro-icon/components';

interface Props {
  kind?: 'note' | 'warn' | 'tip';
  title?: string;
}
const { kind = 'note', title } = Astro.props;
const iconName = kind === 'warn' ? 'lucide:alert-triangle' : kind === 'tip' ? 'lucide:lightbulb' : 'lucide:info';
---

<aside class={`callout callout-${kind}`}>
  <div class="head">
    <Icon name={iconName} />
    <strong>{title ?? kind.charAt(0).toUpperCase() + kind.slice(1)}</strong>
  </div>
  <div class="body"><slot /></div>
</aside>

<style>
  .callout {
    background: var(--accent-bg);
    border: 1px solid color-mix(in oklab, var(--accent) 30%, transparent);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-6) 0;
  }
  .head {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .head :global(svg) { width: 16px; height: 16px; }
  .body :global(p) { margin: 0; }
</style>
