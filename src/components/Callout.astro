---
import { Icon } from 'astro-icon/components';

interface Props {
  kind?: 'note' | 'warn' | 'tip';
  title?: string;
}
const { kind = 'note', title } = Astro.props;
const iconName = kind === 'warn' ? 'lucide:alert-triangle' : kind === 'tip' ? 'lucide:lightbulb' : 'lucide:info';
---

<aside class="my-6 rounded-sm border border-accent/30 border-l-[3px] border-l-accent bg-accent-bg px-4 py-3">
  <div class="mb-2 inline-flex items-center gap-2 font-mono text-sm text-accent">
    <Icon name={iconName} class="size-4" />
    <strong>{title ?? kind.charAt(0).toUpperCase() + kind.slice(1)}</strong>
  </div>
  <div class="[&_p]:m-0"><slot /></div>
</aside>
