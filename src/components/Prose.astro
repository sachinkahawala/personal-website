---
// Typography wrapper for MDX content. Owns post-body styles.
const proseClass = [
  'max-w-[68ch] text-md leading-base text-fg',
  '[&>*+*]:mt-4 [&>*+h2]:mt-12 [&>*+h3]:mt-8',
  '[&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:text-fg',
  '[&_h3]:text-xl [&_h3]:font-semibold [&_h3]:leading-tight [&_h3]:text-fg',
  '[&_h4]:text-lg [&_h4]:font-semibold [&_h4]:leading-tight [&_h4]:text-fg',
  '[&_p]:text-fg',
  '[&_a]:border-b [&_a]:border-accent/40 [&_a]:text-accent [&_a]:transition-colors [&_a]:duration-150 [&_a]:ease-out [&_a:hover]:border-current',
  '[&_ul]:m-0 [&_ul]:list-disc [&_ul]:pl-[1.4em] [&_ol]:m-0 [&_ol]:list-decimal [&_ol]:pl-[1.4em]',
  '[&_li+li]:mt-2 [&_li::marker]:text-subtle',
  '[&_strong]:font-semibold [&_strong]:text-fg [&_em]:text-fg',
  '[&_blockquote]:m-0 [&_blockquote]:rounded-r-sm [&_blockquote]:border-l-[3px] [&_blockquote]:border-accent [&_blockquote]:bg-elevated [&_blockquote]:px-4 [&_blockquote]:py-2 [&_blockquote]:text-muted',
  '[&_hr]:my-8 [&_hr]:border-0 [&_hr]:border-t [&_hr]:border-border',
  '[&_img]:my-6 [&_img]:rounded-md [&_figure]:my-6 [&_figure]:rounded-md',
  '[&_figcaption]:mt-2 [&_figcaption]:text-center [&_figcaption]:text-sm [&_figcaption]:text-muted',
  '[&_pre]:my-4',
  '[&_table]:my-6 [&_table]:w-full [&_table]:border-collapse [&_table]:text-sm',
  '[&_th]:border-b [&_th]:border-border-strong [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:align-top [&_th]:font-mono [&_th]:text-xs [&_th]:uppercase [&_th]:tracking-[0.04em] [&_th]:text-muted',
  '[&_td]:border-b [&_td]:border-border [&_td]:px-3 [&_td]:py-2 [&_td]:text-left [&_td]:align-top',
  '[&_td_code]:text-[0.9em] [&_th_code]:text-[0.9em]',
].join(' ');
---

<div class={proseClass}>
  <slot />
</div>
