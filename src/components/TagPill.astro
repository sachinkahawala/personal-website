---
interface Props {
  tag: string;
  href?: string;
  size?: 'sm' | 'md';
}
const { tag, href, size = 'md' } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element
  class:list={[
    'inline-flex items-center gap-px rounded-sm border border-border bg-elevated font-mono leading-normal text-muted',
    size === 'sm' ? 'px-1.5 py-px text-[0.7rem]' : 'px-2 py-0.5 text-xs',
    href && 'transition-colors duration-150 ease-out hover:border-accent hover:text-accent',
  ]}
  {...href ? { href } : {}}
>
  <span class="mr-0.5 text-subtle">#</span>{tag}
</Element>
