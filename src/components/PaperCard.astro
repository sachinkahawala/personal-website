---
import { Icon } from 'astro-icon/components';

interface Props {
  paper: {
    title: string;
    authors: string[];
    venue: string;
    year: number;
    links?: { pdf?: string; doi?: string; scholar?: string };
  };
  myName?: string;
}
const { paper, myName = 'Sachin Kahawala' } = Astro.props;
---

<article class="border-b border-border py-6 last:border-b-0">
  <div class="mb-2 inline-flex items-center gap-2 font-mono text-xs text-subtle">
    <span class="rounded-sm border border-border bg-code px-2 py-0.5 text-muted">{paper.venue}</span>
    <span class="text-subtle">{paper.year}</span>
  </div>
  <h3 class="mb-2 text-lg font-semibold leading-[1.35] text-fg">{paper.title}</h3>
  <p class="mb-3 text-sm text-muted">
    {paper.authors.map((a, i) => (
      <>
        {a === myName ? <strong class="font-semibold text-fg">{a}</strong> : a}{i < paper.authors.length - 1 && <span>, </span>}
      </>
    ))}
  </p>
  {paper.links && (paper.links.pdf || paper.links.doi || paper.links.scholar) && (
    <div class="inline-flex gap-4 font-mono text-xs">
      {paper.links.pdf && (
        <a class="inline-flex items-center gap-1 text-muted transition-colors duration-150 ease-out hover:text-accent" href={paper.links.pdf} target="_blank" rel="noopener">
          <Icon name="lucide:file-text" class="size-3.5" /> PDF
        </a>
      )}
      {paper.links.doi && (
        <a class="inline-flex items-center gap-1 text-muted transition-colors duration-150 ease-out hover:text-accent" href={paper.links.doi} target="_blank" rel="noopener">
          <Icon name="lucide:link" class="size-3.5" /> DOI
        </a>
      )}
      {paper.links.scholar && (
        <a class="inline-flex items-center gap-1 text-muted transition-colors duration-150 ease-out hover:text-accent" href={paper.links.scholar} target="_blank" rel="noopener">
          <Icon name="lucide:graduation-cap" class="size-3.5" /> Scholar
        </a>
      )}
    </div>
  )}
</article>
