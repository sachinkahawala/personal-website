---
import { Icon } from 'astro-icon/components';
---

<button
  id="theme-toggle"
  class="inline-flex size-9 items-center justify-center rounded-sm border border-border text-muted transition-colors duration-150 ease-out hover:border-border-strong hover:bg-elevated hover:text-fg"
  type="button"
  aria-label="Toggle color theme"
  title="Toggle theme (light / dark)"
>
  <Icon name="lucide:sun" class="hidden size-[18px] theme-light:block" aria-hidden="true" />
  <Icon name="lucide:moon" class="hidden size-[18px] theme-dark-pref:block" aria-hidden="true" />
  <Icon name="lucide:monitor" class="hidden size-[18px] theme-system:block" aria-hidden="true" />
</button>

<script is:inline>
  (() => {
    const bind = () => {
      const btn = document.getElementById('theme-toggle');
      if (!btn || btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const effective = document.documentElement.getAttribute('data-theme');
        const next = effective === 'dark' ? 'light' : 'dark';
        localStorage.setItem('theme', next);
        window.__applyTheme();
      });
    };
    bind();
    document.addEventListener('astro:page-load', bind);
  })();
</script>
