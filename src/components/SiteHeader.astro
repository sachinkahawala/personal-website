---
import { site } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-[10px] backdrop-saturate-[180%]">
  <div class="mx-auto flex max-w-page items-center gap-4 px-4 py-3 min-[720px]:px-8 min-[720px]:py-4">
    <a href="/" class="inline-flex items-baseline gap-2 font-mono text-sm text-fg transition-colors duration-150 ease-out hover:text-accent" aria-label="Home">
      <span class="text-accent">$</span>
      <span class="text-fg">{site.shortName}@melbourne</span>
    </a>

    <nav class="hidden flex-1 justify-center gap-4 min-[720px]:inline-flex" aria-label="Primary">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-sm px-2 py-1 font-mono text-sm transition-colors duration-150 ease-out hover:text-fg',
            isActive(item.href) ? 'text-accent' : 'text-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/cv.pdf"
        class="inline-flex items-center gap-1 rounded-sm border border-border px-2 py-1 font-mono text-sm text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent"
        target="_blank"
        rel="noopener"
        download
      >
        CV <Icon name="lucide:arrow-down" class="size-3.5" aria-hidden="true" />
      </a>
    </nav>

    <ThemeToggle />
  </div>
</header>
