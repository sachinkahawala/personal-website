---
import { site } from '../lib/site';
---

<section class="pb-8 pt-12">
  <div class="mx-auto max-w-[720px] overflow-hidden rounded-lg border border-border bg-elevated shadow-md" role="img" aria-label="Terminal-style intro panel">
    <div class="flex items-center gap-2 border-b border-border bg-code px-4 py-3 font-mono text-xs text-subtle">
      <span class="size-[11px] rounded-full bg-[#ff5f57]"></span>
      <span class="size-[11px] rounded-full bg-[#febc2e]"></span>
      <span class="size-[11px] rounded-full bg-[#28c840]"></span>
      <span class="ml-3">sachin@melbourne:~</span>
    </div>
    <div class="p-6 font-mono text-sm leading-[1.7] text-fg [&_p]:m-0">
      <p><span class="font-semibold text-accent">$</span> whoami</p>
      <p class="pl-3 text-muted"><span class="text-accent">→</span> {site.name} &middot; {site.role}</p>
      <p>&nbsp;</p>
      <p><span class="font-semibold text-accent">$</span> cat about.md</p>
      <p class="pl-3 text-muted">PhD in AI. Ship LLM + ML systems at PS Hummingbird.</p>
      <p class="pl-3 text-muted">Based in {site.location.split(',')[0]}.</p>
      <p>&nbsp;</p>
      <p><span class="font-semibold text-accent">$</span> ls ~/</p>
      <p class="flex flex-wrap gap-x-4 gap-y-3 pl-3 text-muted">
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/about">about/</a>
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/blog">blog/</a>
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/projects">projects/</a>
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/research">research/</a>
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/cv.pdf" target="_blank" rel="noopener">cv.pdf</a>
      </p>
      <p><span class="font-semibold text-accent">$</span> <span class="animate-caret-blink text-accent motion-reduce:animate-none">▍</span></p>
    </div>
  </div>
</section>
