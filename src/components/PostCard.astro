---
import TagPill from './TagPill.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const dateStr = pubDate.toISOString().slice(0, 10);
---

<article class="border-b border-border py-6 last:border-b-0">
  <a href={`/blog/${post.id}`} class="group block text-fg" aria-label={title}>
    <header class="mb-2 flex items-center gap-3 font-mono text-xs text-subtle">
      <time datetime={dateStr}>{dateStr}</time>
      {tags.length > 0 && (
        <span class="inline-flex flex-wrap gap-2">
          {tags.slice(0, 3).map((t) => <TagPill tag={t} size="sm" />)}
        </span>
      )}
    </header>
    <h3 class="mb-2 text-xl font-semibold leading-tight text-fg transition-colors duration-150 ease-out group-hover:text-accent">{title}</h3>
    <p class="max-w-[60ch] text-md leading-[1.55] text-muted">{description}</p>
  </a>
</article>
