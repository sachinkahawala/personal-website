---
import TagPill from './TagPill.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const dateStr = pubDate.toISOString().slice(0, 10);
---

<article class="card">
  <a href={`/blog/${post.id}`} class="link" aria-label={title}>
    <header class="meta">
      <time datetime={dateStr}>{dateStr}</time>
      {tags.length > 0 && (
        <span class="tags">
          {tags.slice(0, 3).map((t) => <TagPill tag={t} size="sm" />)}
        </span>
      )}
    </header>
    <h3 class="title">{title}</h3>
    <p class="dek">{description}</p>
  </a>
</article>

<style>
  .card {
    border-bottom: 1px solid var(--border);
    padding: var(--space-6) 0;
  }
  .card:last-child { border-bottom: 0; }

  .link {
    display: block;
    color: inherit;
    border-bottom: 0;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-subtle);
    margin-bottom: var(--space-2);
  }
  .tags { display: inline-flex; gap: var(--space-2); flex-wrap: wrap; }

  .title {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-2);
    transition: color var(--transition);
  }
  .link:hover .title { color: var(--accent); }

  .dek {
    color: var(--fg-muted);
    font-size: var(--fs-md);
    line-height: 1.55;
    max-width: 60ch;
  }
</style>
