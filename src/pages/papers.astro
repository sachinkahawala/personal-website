---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';

const papers = (await getCollection('papers'))
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year);

const grouped: Record<string, typeof papers> = {};
for (const p of papers) {
  const y = String(p.year);
  (grouped[y] ??= []).push(p);
}
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Papers" description={`Selected publications by ${site.name}.`}>
  <div class="page prose-width" style="margin-inline: auto;">
    <header class="hero">
      <p class="kicker">papers</p>
      <h1>Publications</h1>
      <p class="lede">Selected publications. {papers.length} entries.</p>
    </header>

    {years.map((y) => (
      <section class="year-block">
        <h2 class="year">{y}</h2>
        <div class="paper-list">
          {grouped[y].map((p) => <PaperCard paper={p} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .hero { margin-bottom: var(--space-12); }
  .kicker { font-family: var(--font-mono); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin-bottom: var(--space-2); }
  h1 { font-size: var(--fs-3xl); margin-bottom: var(--space-2); }
  .lede { color: var(--fg-muted); font-size: var(--fs-md); }

  .year-block + .year-block { margin-top: var(--space-12); }
  .year {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-2);
  }
</style>
