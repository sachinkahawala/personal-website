---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Selected industry-oriented AI projects.">
  <div class="page">
    <header class="hero">
      <p class="kicker">projects</p>
      <h1>Selected work</h1>
      <p class="lede">Production AI systems I've designed and delivered across LLMs, RAG, forecasting, computer vision, and real-time agents.</p>
    </header>

    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .hero { max-width: var(--content-width); margin: 0 auto var(--space-12); }
  .kicker { font-family: var(--font-mono); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin-bottom: var(--space-2); }
  h1 { font-size: var(--fs-3xl); margin-bottom: var(--space-2); }
  .lede { color: var(--fg-muted); font-size: var(--fs-md); }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
