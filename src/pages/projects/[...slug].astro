---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, role, client, period, stack, outcome } = project.data;
---

<BaseLayout title={title} description={outcome}>
  <article class="mx-auto max-w-content px-4 py-8 md:px-8 md:py-12">
    <header class="mb-8">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.08em]"><a class="text-accent" href="/projects">projects</a></p>
      <h1 class="mb-4 text-3xl font-semibold leading-[1.15] text-fg">{title}</h1>
      <ul class="mb-4 flex list-none flex-wrap gap-x-6 gap-y-2 rounded-sm border border-border bg-elevated px-4 py-3 font-mono text-xs">
        <li><span class="mr-2 uppercase tracking-[0.06em] text-subtle">Role</span><span class="text-fg">{role}</span></li>
        {client && <li><span class="mr-2 uppercase tracking-[0.06em] text-subtle">Client</span><span class="text-fg">{client}</span></li>}
        <li><span class="mr-2 uppercase tracking-[0.06em] text-subtle">Period</span><span class="text-fg">{period}</span></li>
      </ul>
      <p class="border-l-[3px] border-accent pl-3 text-md leading-normal text-fg">{outcome}</p>
    </header>

    <Prose>
      <Content />
    </Prose>

    {stack.length > 0 && (
      <section class="mt-12 border-t border-border pt-6">
        <h3 class="mb-3 font-mono text-xs uppercase tracking-[0.06em] text-subtle">Stack</h3>
        <ul class="flex list-none flex-wrap gap-1.5 p-0">
          {stack.map((s) => <li class="rounded-sm border border-border bg-code px-2 py-[3px] font-mono text-xs text-muted">{s}</li>)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
