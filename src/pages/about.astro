---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../lib/site';

const skills = [
  { group: 'LLM', items: ['LangChain', 'LangGraph', 'LlamaIndex', 'DeepEval', 'OpenAI GPTx', 'Azure OpenAI', 'Gemini', 'Hugging Face', 'DSPy', 'Semantic Kernel'] },
  { group: 'Programming', items: ['Python', 'C++', 'R', 'TypeScript'] },
  { group: 'ML / DL', items: ['PyTorch', 'Scikit-learn', 'TensorFlow', 'XGBoost'] },
  { group: 'Web / API', items: ['Flask', 'FastAPI', 'React'] },
  { group: 'Data / BI', items: ['Power BI', 'Tableau'] },
  { group: 'MLOps / CI-CD', items: ['MLFlow', 'GitHub Actions', 'Azure DevOps', 'Git'] },
  { group: 'Cloud', items: ['Azure', 'GCP', 'AWS'] },
  { group: 'AI platforms', items: ['Azure ML', 'Microsoft Foundry', 'Vertex AI', 'Databricks'] },
  { group: 'Databases', items: ['SQL', 'NoSQL', 'Redis', 'Cosmos DB'] },
  { group: 'Infra', items: ['Docker', 'Container Apps', 'Service Bus'] },
];

const experience = [
  { role: 'Senior Data Scientist & AI Architect', org: 'PS Hummingbird', loc: 'Melbourne, AU', when: 'Jan 2026 - Present' },
  { role: 'Data Scientist & AI Architect', org: 'PS Hummingbird', loc: 'Melbourne, AU', when: 'Oct 2024 - Dec 2025' },
  { role: 'Data Scientist', org: 'Centre for Data Analytics & Cognition, La Trobe University', loc: 'Melbourne, AU', when: 'Sep 2020 - Sep 2024' },
  { role: 'Doctoral Candidate', org: 'La Trobe University', loc: 'Melbourne, AU', when: 'May 2021 - Jul 2024' },
  { role: 'Research Collaborator', org: 'Luleå University of Technology (with Intel)', loc: 'Luleå, Sweden', when: 'Sep 2020 - Jun 2024' },
  { role: 'Postgraduate Tutor', org: 'La Trobe University', loc: 'Melbourne, AU', when: 'Jun 2022 - Jan 2024' },
  { role: 'Research Assistant (intern)', org: 'Zeptolytics (Pvt) Ltd', loc: 'Sri Lanka', when: 'Jul 2018 - Jan 2019' },
];

const education = [
  { degree: 'PhD in Artificial Intelligence', org: 'La Trobe University, Australia', when: '2021 - 2024' },
  { degree: 'B.Sc. (Hons) Computer Science and Engineering', org: 'University of Moratuwa, Sri Lanka', when: '2015 - 2019' },
  { degree: 'GCE Advanced Level', org: 'Dharmaraja College, Sri Lanka. Ranked 18th (top 0.03%) in Physical Science.', when: '2014' },
];

const awards = [
  'Amazon ML Summer School, Participant (2024)',
  'IEEEXtreme v17.0, Country rank 5th, Global 355th (2023)',
  'National Patent: Method and Apparatus for Detecting Surface Defects (2022)',
  'IEEEXtreme v11.0, Country rank 10th, Global 201st (2017)',
  'IEEEXtreme v10.0, Country rank 6th, Global 181st (2016)',
];

const sectionHeadingClass = 'mb-6 border-b border-border pb-2 text-xl font-semibold leading-tight text-fg';
const chipClass = 'rounded-sm border border-border bg-code px-2 py-[3px] font-mono text-xs text-muted';
const plainItemClass = 'border-b border-border py-3 text-fg last:border-b-0';
---

<BaseLayout title="About" description={`About ${site.name}, ${site.role}.`}>
  <div class="mx-auto max-w-content px-4 py-8 md:px-8 md:py-12">
    <header class="mb-12">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.08em] text-accent">about</p>
      <h1 class="mb-2 text-3xl font-semibold leading-tight text-fg">{site.name}</h1>
      <p class="text-md text-muted">{site.role} based in {site.location}.</p>
    </header>

    <section class="mt-16 [&_p]:mt-4 [&_p]:leading-[1.7] [&_p]:text-fg [&_p:first-child]:mt-0 [&_strong]:font-semibold [&_strong]:text-fg">
      <p>
        I'm a Data Scientist and AI Engineer with 6+ years of experience and a PhD in Artificial Intelligence.
        I design, build, and ship AI and machine learning systems across research and industry, spanning
        generative AI, deep learning, forecasting, and computer vision.
      </p>
      <p>
        I'm comfortable end-to-end: rapid prototyping, experimentation, and production deployment on cloud
        platforms, with a track record of delivering reliable, measurable outcomes on complex,
        data-intensive problems. My algorithmic foundation comes from years of competitive programming.
      </p>
      <p>
        Currently leading the design and delivery of production AI systems at <strong>PS Hummingbird</strong>,
        with a focus on LLM pipelines, multi-agent workflows, and the evaluation infrastructure that makes
        them safe to ship.
      </p>
    </section>

    <section class="mt-16">
      <h2 class={sectionHeadingClass}>Skills</h2>
      <div class="grid grid-cols-1 gap-6 min-[720px]:grid-cols-2">
        {skills.map((g) => (
          <div>
            <h4 class="mb-3 font-mono text-xs uppercase tracking-[0.06em] text-subtle">{g.group}</h4>
            <ul class="flex list-none flex-wrap gap-1.5 p-0">
              {g.items.map((it) => <li class={chipClass}>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-16">
      <h2 class={sectionHeadingClass}>Experience</h2>
      <ol class="list-none p-0">
        {experience.map((e) => (
          <li class="grid grid-cols-1 gap-1 border-b border-border py-4 last:border-b-0 min-[720px]:grid-cols-[180px_1fr] min-[720px]:gap-4">
            <div class="font-mono text-xs text-subtle">{e.when}</div>
            <div>
              <div class="font-semibold text-fg">{e.role}</div>
              <div class="mt-0.5 text-sm text-muted">{e.org} · {e.loc}</div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-16">
      <h2 class={sectionHeadingClass}>Education</h2>
      <ul class="list-none p-0">
        {education.map((e) => (
          <li class={plainItemClass}>
            <strong class="font-semibold text-fg">{e.degree}</strong>, {e.org}
            <span class="float-right font-mono text-xs text-subtle">{e.when}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class={sectionHeadingClass}>Awards & achievements</h2>
      <ul class="list-none p-0">
        {awards.map((a) => <li class={plainItemClass}>{a}</li>)}
      </ul>
    </section>

    <section class="mt-16 text-center">
      <a href="/cv.pdf" target="_blank" rel="noopener" download class="inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-3 font-mono text-sm text-accent-fg transition-opacity duration-150 ease-out hover:opacity-85">
        <Icon name="lucide:download" class="size-4" /> Download CV (PDF)
      </a>
    </section>
  </div>
</BaseLayout>
