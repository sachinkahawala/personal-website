---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Page not found." noIndex={true}>
  <div class="page">
    <div class="terminal">
      <p><span class="prompt">$</span> cat {Astro.url.pathname}</p>
      <p class="err">cat: {Astro.url.pathname}: No such file or directory</p>
      <p>&nbsp;</p>
      <p><span class="prompt">$</span> ls ~/</p>
      <p class="paths">
        <a href="/">home</a>
        <a href="/about">about</a>
        <a href="/blog">writing</a>
        <a href="/projects">projects</a>
        <a href="/papers">papers</a>
      </p>
      <p class="cursor"><span class="prompt">$</span> <span class="caret">▍</span></p>
    </div>
  </div>
</BaseLayout>

<style>
  .terminal {
    max-width: 640px;
    margin: var(--space-16) auto;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }
  p { margin: 0; }
  .prompt { color: var(--accent); font-weight: 600; }
  .err { color: #ef4444; padding-left: var(--space-3); }
  .paths { display: flex; flex-wrap: wrap; gap: var(--space-4); padding-left: var(--space-3); }
  .paths a {
    color: var(--fg);
    border-bottom: 1px dashed var(--border-strong);
  }
  .paths a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .caret {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
  }
</style>
