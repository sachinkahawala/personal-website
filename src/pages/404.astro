---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Page not found." noIndex={true}>
  <div class="mx-auto max-w-page px-4 py-8 md:px-8 md:py-12">
    <div class="mx-auto my-16 max-w-[640px] rounded-md border border-border bg-elevated p-8 font-mono text-sm leading-[1.7] text-fg [&_p]:m-0">
      <p><span class="font-semibold text-accent">$</span> cat {Astro.url.pathname}</p>
      <p class="pl-3 text-red-500">cat: {Astro.url.pathname}: No such file or directory</p>
      <p>&nbsp;</p>
      <p><span class="font-semibold text-accent">$</span> ls ~/</p>
      <p class="flex flex-wrap gap-4 pl-3">
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/">home</a>
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/about">about</a>
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/blog">writing</a>
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/projects">projects</a>
        <a class="border-b border-dashed border-border-strong text-fg transition-colors duration-150 ease-out hover:border-accent hover:text-accent" href="/research">research</a>
      </p>
      <p><span class="font-semibold text-accent">$</span> <span class="animate-caret-blink text-accent motion-reduce:animate-none">▍</span></p>
    </div>
  </div>
</BaseLayout>
