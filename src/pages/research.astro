---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';

const entries = (await getCollection('papers'))
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year);

const thesis = entries.find((p) => p.type === 'thesis');
const papers = entries.filter((p) => p.type !== 'thesis');

const TEASER_END = 'low-energy and low-resource settings.';
const teaserIdx = thesis?.abstract ? thesis.abstract.indexOf(TEASER_END) : -1;
const abstractTeaser =
  teaserIdx >= 0 ? thesis!.abstract!.slice(0, teaserIdx + TEASER_END.length) : thesis?.abstract;
const abstractRest = teaserIdx >= 0 ? thesis!.abstract!.slice(teaserIdx + TEASER_END.length).trim() : '';

const grouped: Record<string, typeof papers> = {};
for (const p of papers) {
  const y = String(p.year);
  (grouped[y] ??= []).push(p);
}
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Research" description={`PhD thesis and selected publications by ${site.name}.`}>
  <div class="mx-auto max-w-content px-4 py-8 md:px-8 md:py-12">
    <header class="mb-18">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.08em] text-accent">research</p>
      <h1 class="mb-3 text-3xl font-semibold leading-tight text-fg">Research</h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-muted">
        <span class="rounded-sm border border-border bg-code px-2 py-0.5">{site.scholarStats.citations} citations</span>
        <span class="rounded-sm border border-border bg-code px-2 py-0.5">h-index {site.scholarStats.hIndex}</span>
        <span class="rounded-sm border border-border bg-code px-2 py-0.5">i10-index {site.scholarStats.i10Index}</span>
        <a class="inline-flex items-center gap-1 text-muted transition-colors duration-150 ease-out hover:text-accent" href={site.socials.scholar} target="_blank" rel="noopener">
          <Icon name="lucide:graduation-cap" class="size-3.5" /> Google Scholar
        </a>
      </div>
      <p class="mt-3 text-sm text-muted">A selected set of publications, the full list is on <a class="text-accent transition-colors duration-150 ease-out hover:text-accent" href={site.socials.scholar} target="_blank" rel="noopener">Google Scholar</a>.</p>
    </header>

    {thesis && (
      <section>
        <h2 class="mb-2 border-b border-border pb-2 font-mono text-xs uppercase tracking-[0.08em] text-subtle">PhD Thesis</h2>
        <article class="py-6">
          <div class="mb-2 inline-flex items-center gap-2 font-mono text-xs text-subtle">
            <span class="rounded-sm border border-border bg-code px-2 py-0.5 text-muted">{thesis.venue}</span>
            <span class="text-subtle">{thesis.year}</span>
          </div>
          <h3 class="mb-3 text-xl font-semibold leading-[1.35] text-fg">{thesis.title}</h3>
          {abstractTeaser && <p class="mb-3 text-sm leading-relaxed text-muted">{abstractTeaser}</p>}
          {abstractRest && (
            <details class="mb-3 group">
              <summary class="cursor-pointer font-mono text-xs text-muted transition-colors duration-150 ease-out hover:text-accent">Read full abstract</summary>
              <p class="mt-3 text-sm leading-relaxed text-muted">{abstractRest}</p>
            </details>
          )}
          {thesis.links && (thesis.links.pdf || thesis.links.repository) && (
            <div class="inline-flex gap-4 font-mono text-xs">
              {thesis.links.pdf && (
                <a class="inline-flex items-center gap-1 text-muted transition-colors duration-150 ease-out hover:text-accent" href={thesis.links.pdf} target="_blank" rel="noopener">
                  <Icon name="lucide:file-text" class="size-3.5" /> PDF
                </a>
              )}
              {thesis.links.repository && (
                <a class="inline-flex items-center gap-1 text-muted transition-colors duration-150 ease-out hover:text-accent" href={thesis.links.repository} target="_blank" rel="noopener">
                  <Icon name="lucide:link" class="size-3.5" /> Thesis page
                </a>
              )}
            </div>
          )}
        </article>
      </section>
    )}

    {years.map((y) => (
      <section class="mt-12">
        <h2 class="mb-2 border-b border-border pb-2 font-mono text-xs uppercase tracking-[0.08em] text-subtle">{y}</h2>
        <div>
          {grouped[y].map((p) => <PaperCard paper={p} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
