---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <div class="mx-auto max-w-content px-4 py-8 md:px-8 md:py-12">
    <p class="mb-2 font-mono text-xs uppercase tracking-[0.08em]"><a class="text-accent" href="/blog">writing</a></p>
    <h1 class="mb-2 font-mono text-2xl font-semibold leading-tight text-fg">#{tag}</h1>
    <p class="mb-8 text-md text-muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged with this.</p>
    <div>
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</BaseLayout>
