---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groupedByYear: Record<string, typeof posts> = {};
for (const p of posts) {
  const y = p.data.pubDate.getUTCFullYear().toString();
  (groupedByYear[y] ??= []).push(p);
}
const years = Object.keys(groupedByYear).sort((a, b) => Number(b) - Number(a));

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout title="Writing" description="Notes on AI systems, research, and engineering.">
  <div class="mx-auto max-w-content px-4 py-8 md:px-8 md:py-12">
    <header class="mb-8">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.08em] text-accent">writing</p>
      <h1 class="mb-2 text-3xl font-semibold leading-tight text-fg">Notes</h1>
      <p class="text-md text-muted">Notes on AI systems, research, and engineering. {posts.length} posts so far.</p>
    </header>

    <div class="mb-8 flex flex-col gap-3">
      <input
        id="search"
        class="w-full rounded-sm border border-border-strong bg-elevated px-3 py-2 font-mono text-fg"
        type="search"
        placeholder="Search posts…"
        aria-label="Search posts"
      />
      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {allTags.map((t) => <TagPill tag={t} href={`/blog/tags/${t}`} size="sm" />)}
        </div>
      )}
    </div>

    <div id="results">
      {years.map((y) => (
        <section class="mt-12 first:mt-0">
          <h2 class="mb-2 border-b border-border pb-2 font-mono text-xs uppercase tracking-[0.08em] text-subtle">{y}</h2>
          <div>
            {groupedByYear[y].map((p) => <PostCard post={p} />)}
          </div>
        </section>
      ))}
      {posts.length === 0 && <p class="text-muted">No posts yet.</p>}
    </div>
  </div>

  <script>
    // Client-side filter. In dev, falls back to a simple in-page text filter.
    // In production, Pagefind index is built into /pagefind/ and provides full-text search.
    const input = document.getElementById('search') as HTMLInputElement | null;
    const results = document.getElementById('results');
    if (input && results) {
      let pagefind: any = null;
      const tryLoadPagefind = async () => {
        try {
          // Built by pagefind CLI after astro build; doesn't exist in dev.
          // The /* @vite-ignore */ + assembled URL keeps Vite from trying to resolve it.
          const url = '/pagefind/pagefind' + '.js';
          // @ts-ignore
          pagefind = await import(/* @vite-ignore */ url);
          await pagefind.options({ baseUrl: '/' });
        } catch {
          pagefind = null; // dev / no index
        }
      };
      tryLoadPagefind();

      const articles = Array.from(results.querySelectorAll<HTMLElement>('article'));
      const byHref = new Map<string, HTMLElement>();
      for (const a of articles) {
        const link = a.querySelector('a')?.getAttribute('href');
        if (link) byHref.set(link.replace(/\/$/, ''), a);
      }

      const filter = async (q: string) => {
        if (!q) {
          articles.forEach((a) => (a.style.display = ''));
          return;
        }
        if (pagefind) {
          const search = await pagefind.search(q);
          const matches = new Set(
            (await Promise.all(search.results.map((r: any) => r.data()))).map((d: any) =>
              d.url.replace(/\/$/, '')
            )
          );
          articles.forEach((a) => {
            const href = a.querySelector('a')?.getAttribute('href')?.replace(/\/$/, '') ?? '';
            a.style.display = matches.has(href) ? '' : 'none';
          });
        } else {
          const lo = q.toLowerCase();
          articles.forEach((a) => {
            a.style.display = (a.textContent ?? '').toLowerCase().includes(lo) ? '' : 'none';
          });
        }
      };

      input.addEventListener('input', () => filter(input.value.trim()));
    }
  </script>
</BaseLayout>
