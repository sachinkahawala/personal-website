---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
const dateStr = pubDate.toISOString().slice(0, 10);

const minutes = remarkPluginFrontmatter?.minutesRead ?? null;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-content px-4 py-8 md:px-8 md:py-12" data-pagefind-body>
    <header class="mb-8">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.08em]"><a class="text-accent" href="/blog">writing</a></p>
      <h1 class="mb-3 text-3xl font-semibold leading-[1.15] text-fg">{title}</h1>
      <p class="flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
        <time class="text-muted" datetime={dateStr}>{dateStr}</time>
        {updatedDate && (
          <>
            <span class="text-subtle">·</span>
            <span>updated {updatedDate.toISOString().slice(0, 10)}</span>
          </>
        )}
        {minutes && (<><span class="text-subtle">·</span><span>{minutes}</span></>)}
        {tags.length > 0 && (
          <>
            <span class="text-subtle">·</span>
            <span class="inline-flex flex-wrap gap-1.5">
              {tags.map((t) => <TagPill tag={t} href={`/blog/tags/${t}`} size="sm" />)}
            </span>
          </>
        )}
      </p>
    </header>

    <Prose>
      <Content />
    </Prose>

    <nav class="mt-16 grid grid-cols-2 gap-4 border-t border-border pt-6" aria-label="More posts">
      {prev ? (
        <a href={`/blog/${prev.id}`} class="flex flex-col gap-1 rounded-sm border border-border p-3 text-fg transition-colors duration-150 ease-out hover:border-accent">
          <span class="font-mono text-xs text-accent">← Previous</span>
          <span class="text-fg">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={`/blog/${next.id}`} class="flex flex-col gap-1 rounded-sm border border-border p-3 text-right text-fg transition-colors duration-150 ease-out hover:border-accent">
          <span class="font-mono text-xs text-accent">Next →</span>
          <span class="text-fg">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>
